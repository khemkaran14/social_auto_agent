# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/social_auto_agent

# --- Redis (Celery broker/result backend) ---
REDIS_URL=redis://localhost:6379/0
# How often the Celery beat task checks for schedules that are due to post.
DISPATCH_INTERVAL_MINUTES=15

# --- App ---
APP_BASE_URL=http://localhost:8000
# Used to sign OAuth state tokens and JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Used to encrypt stored OAuth tokens at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Convenience for local dev only: auto-create tables instead of running alembic migrations.
DEV_AUTO_CREATE_TABLES=true
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Anthropic (content generation) ---
ANTHROPIC_API_KEY=
CONTENT_MODEL=claude-sonnet-5

# --- LinkedIn OAuth app (developer.linkedin.com) ---
# Requires the "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect" products.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# --- Twitter/X OAuth app (developer.twitter.com) ---
# Requires OAuth 2.0 enabled with a confidential client, scopes: tweet.read tweet.write users.read offline.access
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:8000/auth/twitter/callback
